#!/bin/bash
# Rebuilds the rounded corners effect from /usr/src/kwin-effect-rounded-corners-git
# for the installed KWin (run by the pacman hook after a KWin update). If the
# build fails the installed copy stays (KWin just won't load it) until the
# package is rebuilt: ./install.sh --packages
src=/usr/src/kwin-effect-rounded-corners-git
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
if cmake -B "$tmp" -S "$src" -G Ninja -Wno-dev -D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_PREFIX=/usr >"$tmp.log" 2>&1 &&
   cmake --build "$tmp" >>"$tmp.log" 2>&1 &&
   cmake --install "$tmp" >>"$tmp.log" 2>&1; then
  echo "Rounded corners rebuilt for KWin $(pacman -Q kwin | cut -d' ' -f2); log out and in to load it"
  rm -f "$tmp.log"
else
  echo "Rounded corners could not be rebuilt (log: $tmp.log); run: ./install.sh --packages"
fi
exit 0
