# Maintainer: Corey Mwamba <contact.me@coreymwamba.co.uk>
DLAGENTS=("https::/usr/bin/curl -k -o %o %u")
pkgname=qm-vamp-plugins
pkgver=1.8.0
pkgrel=1
pkgdesc="A set of Vamp audio analysis plugins developed at the Centre for Digital Music at Queen Mary, University of London"
arch=('i686' 'x86_64')
url="https://code.soundsoftware.ac.uk/projects/qm-vamp-plugins"
license=('GPL')
groups=(multimedia)
depends=('vamp-plugin-sdk')
# code.soundsoftware.ac.uk is gone: the project's GitHub, with qm-dsp at the
# revision its repoint-lock.json pins
makedepends=('git')
source=("git+https://github.com/c4dm/qm-vamp-plugins.git#tag=qm-vamp-plugins-v1.8.0"
        "git+https://github.com/c4dm/qm-dsp.git#commit=4d2a4a4e0c2dd0ddf07bf9d2a224ded912712714"
        "git+https://github.com/vamp-plugins/vamp-plugin-sdk.git#tag=vamp-plugin-sdk-v2.10")
sha256sums=('SKIP' 'SKIP' 'SKIP')

prepare() {
        cd "$srcdir/qm-vamp-plugins"
        mkdir -p lib && rm -rf lib/qm-dsp && cp -r "$srcdir/qm-dsp" lib/qm-dsp
        rm -rf lib/vamp-plugin-sdk && cp -r "$srcdir/vamp-plugin-sdk" lib/vamp-plugin-sdk
        sed -e "s|CXXFLAGS += |CXXFLAGS += -I/usr/include/vamp-sdk |" -i build/linux/Makefile.linux{64,32}
	sed -e "s|-lvamp-sdk||" -i build/linux/Makefile.linux{64,32}
	sed -e "s|-lpthread|-lpthread -lvamp-sdk|" -i build/linux/Makefile.linux{64,32}
}
build() {
	cd "$srcdir/qm-vamp-plugins"
	# qm-dsp first: the plugin links its static library
	make -C lib/qm-dsp -f build/linux/Makefile.linux64
	if test "$CARCH" == x86_64; then
		make -f build/linux/Makefile.linux64 
	else
		make -f build/linux/Makefile.linux32 
	fi
}


package() {
	mkdir -p $pkgdir/usr/lib/vamp
	cp $srcdir/qm-vamp-plugins/qm-vamp-plugins.{so,cat,n3} $pkgdir/usr/lib/vamp		
}
