# Rebuilds Better Blur DX against the new KWin after every KWin update (a KWin
# effect only loads in the KWin it was built for)
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = kwin

[Action]
Description = Rebuilding Better Blur DX for the new KWin...
When = PostTransaction
Exec = /usr/lib/kwin-effects-better-blur-dx/rebuild
