# Maintainer: Jhyub <jhyub06 at gmail dot com>
# RedRog: built against the installed Plasma, with the RedRog popup (redrog/main.qml),
# line icons (redrog/icons) and a Spanish translation (redrog/es.po)

pkgname='plasma6-applets-supergfxctl'
pkgver=2.1.1
pkgrel=8
pkgdesc="KDE Plasma plasmoid for supergfxctl"
arch=('x86_64')
url="https://gitlab.com/Jhyub/supergfxctl-plasmoid"
license=('MPL-2.0')
depends=('hicolor-icon-theme' 'glibc' 'kcoreaddons' 'kconfig' 'ki18n' 'kirigami' 'ksvg' 'libplasma' 'qt6-base' 'qt6-declarative' 'solid' 'gcc-libs' 'supergfxctl')
makedepends=('cmake' 'extra-cmake-modules' 'gettext')
conflicts=('plasma5-applets-supergfxctl')
source=(
    "https://gitlab.com/Jhyub/supergfxctl-plasmoid/-/archive/v$pkgver/supergfxctl-plasmoid-v$pkgver.tar.gz"
)
sha256sums=(
    'eb7b9e28bc3786abeaea9f4ae565b701033b0a58ded0d9f8e28f7ea2063b00fa'
)

prepare() {
	cd "supergfxctl-plasmoid-v$pkgver"
	local redrog="${REDROG_ROOT:-$startdir/../..}/packages/plasma6-applets-supergfxctl/redrog"
	[ -d "$redrog" ] || redrog="$startdir/redrog"
	cp "$redrog/main.qml" src/package/contents/ui/main.qml
	cp "$redrog"/icons/*.svg icons/status/
	# "Graphics" in the tray instead of SUPERGFX, and modes this laptop can't
	# use hidden unless asked for in the widget's settings
	python3 - src/package/metadata.json <<'PY2'
import json, sys
path = sys.argv[1]
meta = json.load(open(path))
meta["KPlugin"]["Name"] = "Graphics"
meta["KPlugin"]["Name[es]"] = "Gráficos"
meta["KPlugin"]["Description[es]"] = "Cambia el modo de GPU con supergfxd"
json.dump(meta, open(path, "w"), indent=4, ensure_ascii=False)
PY2
	sed -i '/name="showUnsupported"/,/<\/entry>/ s|<default>true</default>|<default>false</default>|' \
		src/package/contents/config/main.xml
}

build() {
	cd "supergfxctl-plasmoid-v$pkgver"
	mkdir -p build
	cd build
	cmake -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_WITH_QT6=ON ..
	make
}

package() {
	cd "supergfxctl-plasmoid-v$pkgver/build"
	make DESTDIR="${pkgdir}/" install
	local redrog="${REDROG_ROOT:-$startdir/../..}/packages/plasma6-applets-supergfxctl/redrog"
	[ -d "$redrog" ] || redrog="$startdir/redrog"
	install -d "$pkgdir/usr/share/locale/es/LC_MESSAGES"
	msgfmt -o "$pkgdir/usr/share/locale/es/LC_MESSAGES/plasma_applet_dev.jhyub.supergfxctl.mo" "$redrog/es.po"
}
