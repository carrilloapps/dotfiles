#!/bin/bash
# RedRog: the login screen's keyboard layout follows the keyboard in use, as
# the session does (modules/keyboard): with one of the listed keyboards
# connected, its layout; without, the first one. Runs in the login screen's
# own session (a user service of the greeter, plasmalogin), and follows
# keyboards being connected or disconnected while it is on screen.
# Settings: /etc/redrog/login-keyboard.conf (modules/system):
#   AUTO_DEVICES  parts of keyboard names, one per line
#   AUTO_INDEX    the index of their layout in the system's layouts
#   DEFAULT_INDEX the layout without them (0, the first)
CONF=/etc/redrog/login-keyboard.conf
[ -r "$CONF" ] || exit 0
# shellcheck source=/dev/null
. "$CONF"
[ -n "${AUTO_DEVICES:-}" ] && [ -n "${AUTO_INDEX:-}" ] || exit 0

# a listed keyboard connected now (a device with a keyboard handler whose
# name holds one of the listed names)
connected() {
  awk -v list="$AUTO_DEVICES" '
    BEGIN { n = split(tolower(list), want, "\n") }
    /^N: Name=/ { name = tolower($0) }
    /^H: Handlers=/ && / kbd / { for (i = 1; i <= n; i++) if (want[i] != "" && index(name, want[i])) found = 1 }
    END { exit !found }' /proc/bus/input/devices
}
apply() {
  local want=${DEFAULT_INDEX:-0}
  connected && want=$AUTO_INDEX
  [ "$want" = "$last" ] && return
  qdbus6 org.kde.keyboard /Layouts org.kde.KeyboardLayouts.setLayout "$want" >/dev/null 2>&1 && last=$want
}

# the greeter's KWin offers its layouts once it is up
for _ in $(seq 60); do
  qdbus6 org.kde.keyboard /Layouts >/dev/null 2>&1 && break
  sleep 0.5
done
last=""
apply
# then every keyboard connected or disconnected (a short pause lets a
# Bluetooth keyboard settle)
udevadm monitor --udev --subsystem-match=input 2>/dev/null | while read -r line; do
  case "$line" in *" add "*|*" remove "*) sleep 0.5; apply ;; esac
done
