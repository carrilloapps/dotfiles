opaque_colors=false
scroll_jump_workaround=false
centered_forms=false
kinetic_scrolling=false
noninteger_translucency=true
blur_only_active_window=false
style_vertical_toolbars=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=button
indicator.size=8
text.normal.color=#eeedec
text.focus.color=#eeedec
text.press.color=#ffffff
text.toggle.color=#ffffff
text.shadow=false
text.shadow.color=black
text.shadow.xshift=1
text.shadow.yshift=1
text.shadow.depth=1
text.shadow.alpha=80
text.margin=1
text.iconspacing=6
indicator.element=arrow
text.margin.top=1
text.margin.bottom=1
text.margin.left=10
text.margin.right=10
frame.expansion=14
min_width=26
min_height=24

