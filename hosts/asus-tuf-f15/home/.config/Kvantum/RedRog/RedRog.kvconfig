[%General]
author=Vince Liuice
comment=A dark theme with translucency similar to the style of macOS Mojave
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
embedded_tabs=true
mirror_doc_tabs=false
group_toolbar_buttons=false
spread_progressbar=true
composite=true
menu_shadow_depth=10
spread_menuitems=false
tooltip_shadow_depth=6
scroll_width=12
scroll_arrows=false
scroll_min_extent=50
transient_scrollbar=true
slider_width=6
slider_handle_width=16
slider_handle_length=16
center_toolbar_handle=true
check_size=16
textless_progressbar=false
progressbar_thickness=0
menubar_mouse_tracking=true
toolbutton_style=0
double_click=false
translucent_windows=true
blurring=true
popup_blurring=true
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,trojita,dragon,digikam,lyx,systemsettings,kinfocenter,kcmshell6
vertical_spin_indicators=false
fill_rubberband=false
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_interior_spacing=6
toolbar_icon_size=16
combo_as_lineedit=true
combo_menu=true
combo_focus_rect=true
groupbox_top_label=false
inline_spin_indicators=true
joined_inactive_tabs=true
layout_spacing=6
submenu_overlap=0
tooltip_delay=-1
button_contents_shift=false
animate_states=true
dark_titlebar=true
hide_combo_checkboxes=false
layout_margin=8
no_window_pattern=false
reduce_window_opacity=12
respect_DE=true
scrollbar_in_view=false
spin_button_width=20
submenu_delay=250
transient_groove=true
tree_branch_line=false
no_inactiveness=false
reduce_menu_opacity=18
click_behavior=0
contrast=1.00
dialog_button_layout=0
intensity=1.00
saturation=1.00
scrollable_menu=true
shadowless_popup=false
drag_from_buttons=false
menu_blur_radius=8
tooltip_blur_radius=8
center_normal_tabs=true
noninteger_translucency=true
menu_separator_height=11
toolbar_item_spacing=4

[GeneralColors]
window.color=#1c1c1c
inactive.window.color=#1c1c1c
base.color=#1c1c1c
inactive.base.color=#1c1c1c
alt.base.color=#262626
inactive.alt.base.color=#212120
button.color=#666664
light.color=#5a5958
mid.light.color=#545352
dark.color=#191919
mid.color=#373737
highlight.color=#f8a0a6
inactive.highlight.color=#f8a0a6
text.color=#eeedec
inactive.text.color=#cccbc8
window.text.color=#eeedec
inactive.window.text.color=#cccbc8
button.text.color=#eeedec
disabled.text.color=#cccbc8
tooltip.base.color=#2d2d2d
tooltip.text.color=#eeedec
highlight.text.color=#ffffff
inactive.highlight.text.color=#fafaf9
link.color=#e23440
link.visited.color=#86282e
progress.indicator.text.color=#ffffff

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=true
transparent_pcmanfm_sidepane=true
blur_translucent=true
transparent_menutitle=true
respect_darkness=true
kcapacitybar_as_progressbar=true
force_size_grip=true
