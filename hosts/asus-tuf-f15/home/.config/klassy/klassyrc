[ButtonColors]
ButtonBackgroundColorsActive=AccentTrafficLights
ButtonBackgroundColorsInactive=AccentTrafficLights

[ButtonSizing]
ButtonSpacingLeft=8
ButtonSpacingRight=8

[Global]
LookAndFeelSet=com.github.vinceliuice.WhiteSur-dark

[ShadowStyle]
ShadowColorActive=0,0,0
ShadowColorInactive=0,0,0
ShadowSizeActive=VeryLarge
ShadowSizeInactive=Large
ShadowStrengthActive=150
ShadowStrengthInactive=90

[TitleBarOpacity]
ActiveTitleBarOpacity=88
ApplyOpacityToHeader=true
BlurTransparentTitleBars=true
InactiveTitleBarOpacity=72
OpaqueMaximizedTitleBars=false
OverrideActiveTitleBarOpacity=true
OverrideInactiveTitleBarOpacity=true
OverrideTitleBarOpacityActive=true
OverrideTitleBarOpacityInactive=true
TitleBarOpacityActive=85
TitleBarOpacityInactive=75

[TitleBarSpacing]
LockTitleBarLeftRightMargins=true
LockTitleBarTopBottomMargins=true
TitleAlignment=AlignCenterFullWidth
TitleBarBottomMargin=5
TitleBarLeftMargin=10
TitleBarRightMargin=10
TitleBarTopMargin=5

[Windeco]
ButtonIconStyle=Kite
ButtonShape=SmallCircle
DrawTitleBarSeparator=false
RoundAllCornersWhenNoBorders=true
WindowCornerRadius=12

[WindowOutlineStyle]
