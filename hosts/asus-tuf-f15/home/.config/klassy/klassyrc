LockWindowOutlineStyleActiveInactive=false
WindowOutlineAccentColorOpacityActive=100
WindowOutlineAccentColorOpacityInactive=40
WindowOutlineContrastOpacityActive=12
WindowOutlineContrastOpacityInactive=8
WindowOutlineSnapToWholePixel=true
WindowOutlineStyleActive=Contrast
WindowOutlineStyleInactive=Contrast
WindowOutlineThickness=1
