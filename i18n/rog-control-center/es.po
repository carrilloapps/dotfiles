#: rog-control-center/ui/pages/system.slint:630
msgctxt "requires_fan_curve_warning"
msgid ""
"CPU power limits require an active custom fan curve. Enable a fan curve for "
"the active profile in the Fans tab to unlock these controls."
msgstr ""
"Los límites de potencia de la CPU requieren una curva de ventilador "
"personalizada. Actívala para el perfil en uso en la pestaña Ventiladores."

#: rog-control-center/ui/pages/system.slint:640
msgctxt "ppt_pl1_spl"
msgid "CPU Sustained Power Limit"
msgstr "Límite de potencia sostenida de la CPU"

#: rog-control-center/ui/pages/system.slint:642
msgctxt "ppt_pl1_spl_help"
msgid ""
"Long-term CPU power limit that affects sustained workload performance. "
"Higher values may increase heat and power consumption."
msgstr ""
"Límite de potencia de la CPU a largo plazo. Valores más altos pueden "
"aumentar el calor y el consumo."

#: rog-control-center/ui/pages/system.slint:658
msgctxt "ppt_pl2_sppt"
msgid "CPU Turbo Power Limit"
msgstr "Límite de potencia turbo de la CPU"

#: rog-control-center/ui/pages/system.slint:660
msgctxt "ppt_pl2_sppt_help"
msgid ""
"Short-term CPU power limit for boost periods. Controls maximum power during "
"brief high-performance bursts."
msgstr ""
"Límite de potencia de la CPU a corto plazo. Controla la potencia máxima en "
"ráfagas breves de alto rendimiento."

#: rog-control-center/ui/pages/system.slint:676
msgctxt "ppt_pl3_fppt"
msgid "CPU Fast Burst Power Limit"
msgstr "Límite de potencia de ráfaga de la CPU"

#: rog-control-center/ui/pages/system.slint:678
msgctxt "ppt_pl3_fppt_help"
msgid ""
"Ultra-short duration power limit for instantaneous CPU bursts. Affects "
"responsiveness during sudden workload spikes."
msgstr ""
"Límite de potencia ultracorto para ráfagas instantáneas de la CPU. Afecta a "
"la respuesta ante picos repentinos."

#: rog-control-center/ui/pages/system.slint:693
msgctxt "ppt_fppt"
msgid "Fast Package Power Limit"
msgstr "Límite de potencia rápida del paquete"

#: rog-control-center/ui/pages/system.slint:695
msgctxt "ppt_fppt_help"
msgid ""
"Ultra-short duration power limit for system package. Controls maximum power "
"during millisecond-scale load spikes."
msgstr ""
"Límite de potencia de duración ultracorta del paquete. Controla la potencia "
"máxima en picos de milisegundos."

#: rog-control-center/ui/pages/system.slint:711
msgctxt "ppt_apu_sppt"
msgid "APU Sustained Power Limit"
msgstr "Límite de potencia sostenida de la APU"

#: rog-control-center/ui/pages/system.slint:713
msgctxt "ppt_apu_sppt_help"
msgid ""
"Long-term power limit for integrated graphics and CPU combined. Affects "
"sustained performance of APU-based workloads."
msgstr ""
"Límite de potencia a largo plazo para la gráfica integrada y la CPU juntas. "
"Afecta al rendimiento sostenido de la APU."

#: rog-control-center/ui/pages/system.slint:729
msgctxt "ppt_platform_sppt"
msgid "Platform Sustained Power Limit"
msgstr "Límite de potencia sostenida de la plataforma"

#: rog-control-center/ui/pages/system.slint:731
msgctxt "ppt_platform_sppt_help"
msgid ""
"Overall system power limit for sustained operations. Controls total platform "
"power consumption over extended periods."
msgstr ""
"Límite de potencia global del sistema para cargas sostenidas. Controla el "
"consumo total durante periodos largos."

#: rog-control-center/ui/pages/system.slint:747
msgctxt "nv_dynamic_boost"
msgid "GPU Power Boost"
msgstr "Refuerzo de potencia de la GPU"

#: rog-control-center/ui/pages/system.slint:749
msgctxt "nv_dynamic_boost_help"
msgid ""
"Additional power allocation for GPU dynamic boost. Higher values increase "
"GPU performance but generate more heat."
msgstr ""
"Potencia adicional para el Dynamic Boost de la GPU. Valores más altos "
"aumentan el rendimiento pero generan más calor."

#: rog-control-center/ui/pages/system.slint:765
msgctxt "nv_tgp"
msgid "GPU TGP"
msgstr "TGP de la GPU"

#: rog-control-center/ui/pages/system.slint:767
msgctxt "nv_tgp_help"
msgid ""
"Total graphics power limit for the dedicated NVIDIA GPU. Higher values can "
"improve performance at the cost of additional heat and power draw."
msgstr ""
"Límite total de potencia de la GPU NVIDIA dedicada. Valores más altos pueden "
"mejorar el rendimiento a costa de más calor y consumo."

#: rog-control-center/ui/pages/system.slint:783
msgctxt "nv_temp_target"
msgid "GPU Temperature Limit"
msgstr "Límite de temperatura de la GPU"

#: rog-control-center/ui/pages/system.slint:785
msgctxt "nv_temp_target_help"
msgid ""
"Maximum GPU temperature threshold in Celsius. GPU will throttle to maintain "
"temperature below this limit."
msgstr ""
"Temperatura máxima de la GPU en grados Celsius. La GPU reducirá su velocidad "
"para mantenerse por debajo."

